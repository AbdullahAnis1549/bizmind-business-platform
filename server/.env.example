# ---- Server ----
PORT=7000
NODE_ENV=production

# ---- Database (MongoDB Atlas) ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bizmind_ai

# ---- Auth ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Frontend URL (exact origin, no trailing slash), e.g. https://your-app.vercel.app
CLIENT_URL=

# ---- Super Admin (REQUIRED for the /admin panel) ----
# Created once on first boot if it doesn't exist. Password must be 12+ chars. Never logged.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# ---- Owner login OTP (optional) ----
ENABLE_OTP=false
# Gmail App Password (also used for the Super Admin 2FA email)
SMTP_EMAIL=
SMTP_PASSWORD=

# ---- AI (optional; leave empty for rule-based mode) ----
# sk-... => OpenAI, anything else => Google Gemini
AI_API_KEY=
AI_MODEL=
# Per-user AI requests per hour (default 30) and provider timeout in ms (default 20000)
AI_HOURLY_LIMIT=30
AI_TIMEOUT_MS=20000

# ---- Seed script safety ----
# npm run seed DELETES ALL DATA. Blocked when NODE_ENV=production unless this is "true".
# ALLOW_SEED=false
